# Environment
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Для локальной разработки используйте SQLite (по умолчанию)
DB_ENGINE=sqlite

# Для MySQL (production на beget.ru):
# DB_ENGINE=mysql
# DB_NAME=watching_together
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=3306

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=86400

# Email (optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-password

# TMDB API (поиск фильмов/сериалов, themoviedb.org)
# Получить ключ: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
